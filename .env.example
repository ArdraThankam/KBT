# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional path for local embedded SQLite storage (defaults to ./data/kbt.sqlite)
KBT_SQLITE_PATH=""

# Optional comma-separated list of emails granted initial admin role
ADMIN_EMAILS=""

# Optional server-side admin passcode override for admin email sign-in
ADMIN_PASSCODE=""
